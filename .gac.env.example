# gac Configuration Example
# Copy this file to .gac.env and customize for your environment
# Configuration priority: .gac.env (project) > ~/.gac.env (global) > environment variables

# =============================================================================
# REQUIRED: Model Selection
# =============================================================================
# Format: provider:model-name
# Run 'uvx gac model' for interactive selection, or see docs/en/PROVIDERS.md for all options

# Popular choices (uncomment one):
# GAC_MODEL=claude-code:claude-sonnet-5
# GAC_MODEL=custom-anthropic:claude-haiku-4-5
# GAC_MODEL=custom-openai:gpt-5.6-luna
# GAC_MODEL=deepseek:deepseek-flash
# GAC_MODEL=groq:openai/gpt-oss-120b
# GAC_MODEL=kimi-for-coding:kimi-for-coding
# GAC_MODEL=minimax:MiniMax-M3
# GAC_MODEL=moonshot:kimi-k3
# GAC_MODEL=mistral:devstral-2512
# GAC_MODEL=replicate:openai/gpt-oss-120b
# GAC_MODEL=together:openai/gpt-oss-120B

# =============================================================================
# AI Provider API Keys
# =============================================================================
# Uncomment and add your key for the provider(s) you want to use

# Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Azure OpenAI
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# Cerebras
# CEREBRAS_API_KEY=csk-xxxxxxxxxxxx
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Chutes.ai
# CHUTES_API_KEY=chutes_xxxxxxxxxxxx
# CHUTES_BASE_URL=https://llm.chutes.ai/v1

# Claude Code (OAuth - configured via 'uvx gac init')
# CLAUDE_CODE_ACCESS_TOKEN=your-oauth-token

# Copilot (GitHub OAuth - configured via 'uvx gac init')
# GITHUB_COPILOT_TOKEN=your-oauth-token

# Crof.ai
# CROF_API_KEY=crof_xxxxxxxxxxxx
# CROF_BASE_URL=https://api.crof.ai/v1

# Custom Anthropic-Compatible Endpoint
# CUSTOM_ANTHROPIC_API_KEY=your-proxy-key
# CUSTOM_ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1
# CUSTOM_ANTHROPIC_VERSION=2023-06-01

# Custom OpenAI-Compatible Endpoint
# CUSTOM_OPENAI_API_KEY=your-proxy-key
# CUSTOM_OPENAI_BASE_URL=https://your-proxy.example.com/v1

# DeepInfra
# DEEPINFRA_API_KEY=your-key
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fireworks AI
# FIREWORKS_API_KEY=fw_xxxxxxxxxxxx
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Google Gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq
# GROQ_API_KEY=gsk_xxxxxxxxxxxx
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Kimi for Coding
# KIMI_API_KEY=sk-xxxxxxxxxxxx
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# Lilac
# LILAC_API_KEY=your-key
# LILAC_BASE_URL=https://api.lilac.ai/v1

# LM Studio (Local)
# LMSTUDIO_API_URL=http://localhost:1234
# LMSTUDIO_API_KEY=your-key  # Optional

# MiniMax
# MINIMAX_API_KEY=your-key
# MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Mistral AI
# MISTRAL_API_KEY=your-key
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Moonshot AI
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxx
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Neuralwatt
# NEURALWATT_API_KEY=your-key
# NEURALWATT_BASE_URL=https://api.neuralwatt.ai/v1

# Ollama (Local)
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_API_KEY=your-key  # Optional

# Ollama Cloud
# OLLAMA_CLOUD_API_KEY=your-key
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/api

# OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=org-xxxxxxxxxxxx

# OpenCode Go
# OPENCODE_GO_API_KEY=your-key
# OPENCODE_GO_BASE_URL=https://api.opencode.ai/v1

# OpenRouter
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://github.com/thomwebb/gac
# OPENROUTER_APP_NAME=gac

# Plexus Gateway
# PLEXUS_API_KEY=your-key
# PLEXUS_BASE_URL=https://your-gateway.example.com/v1

# Qwen (International)
# QWEN_API_KEY=your-key
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# Qwen API (International)
# QWEN_API_KEY=your-key
# QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen API (China)
# QWEN_API_KEY=your-key
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Replicate
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxx
# REPLICATE_BASE_URL=https://api.replicate.com/v1

# Streamlake / Vanchin
# STREAMLAKE_API_KEY=your-key
# STREAMLAKE_BASE_URL=https://api.streamlake.ai/v1

# Synthetic.new
# SYNTHETIC_API_KEY=your-key
# SYNTHETIC_BASE_URL=https://api.synthetic.new/v1

# Together AI
# TOGETHER_API_KEY=your-key
# TOGETHER_BASE_URL=https://api.together.xyz/v1

# Wafer.ai
# WAFER_API_KEY=your-key
# WAFER_BASE_URL=https://pass.Wafer.ai

# Z.ai (GLM)
# ZAI_API_KEY=your-key
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZAI_USE_CODING_PLAN=false

# =============================================================================
# OPTIONAL: gac Behavior Settings
# =============================================================================

# Token limits and generation
# GAC_WARNING_LIMIT_TOKENS=128000
# GAC_MAX_OUTPUT_TOKENS=512
# GAC_TEMPERATURE=0.7
# GAC_REASONING_EFFORT=medium  # low, medium, high (for models that support it)

# Commit message options
# GAC_ALWAYS_INCLUDE_SCOPE=true       # Always infer scope (e.g., feat(auth):)
# GAC_ALWAYS_GROUPED=true             # Always use grouped commit mode (-g flag)
# GAC_VERBOSE=true                    # Detailed messages with motivation, architecture, impact
# GAC_USE_50_72_RULE=true             # Enforce 50/72 rule: subject ≤50 chars, body ≤72 chars
# GAC_TRANSLATE_PREFIXES=true         # Translate conventional prefixes (feat, fix, etc.)
# GAC_SIGNOFF=true                    # Add Signed-off-by line (DCO compliance)

# Language
# GAC_LANGUAGE=Spanish                # Run 'uvx gac language' for interactive selection
# GAC_RTL_CONFIRMED=true              # Suppress RTL warning (auto-set after first RTL selection)

# Security
# GAC_SKIP_SECRET_SCAN=true           # Skip secret detection (use with caution!)
# GAC_NO_VERIFY_SSL=true              # Skip SSL verification (corporate proxies)

# Hooks
# GAC_HOOK_TIMEOUT=30                 # Pre-commit/lefthook timeout in seconds (0 = use config)

# Editor for 'e' at confirmation prompt
# GAC_EDITOR=code --wait              # Run 'uvx gac editor' for interactive selector

# Custom System Prompt
# GAC_SYSTEM_PROMPT_PATH=/path/to/custom_system_prompt.txt

# Statistics
# GAC_DISABLE_STATS=true              # Disable local usage statistics tracking

# Diff context (for better commit messages)
# GAC_DIFF_CONTEXT_LINES=10           # Lines of context in diff (0-100)

# =============================================================================
# QUICK REFERENCE: Common Provider Configurations
# =============================================================================
# Uncomment the block for your provider and fill in your credentials:

## Anthropic (Claude)
# GAC_MODEL=anthropic:claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

## OpenAI
# GAC_MODEL=openai:gpt-4o
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

## Groq (Fast, Free Tier)
# GAC_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxx

## Ollama (Local, Free)
# GAC_MODEL=ollama:llama3.1
# OLLAMA_API_URL=http://localhost:11434

## DeepSeek (Cost-Effective)
# GAC_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx

## Gemini (Long Context)
# GAC_MODEL=gemini:gemini-1.5-pro
# GEMINI_API_KEY=your-gemini-key

## Azure OpenAI (Enterprise)
# GAC_MODEL=azure-openai:my-gpt4o-deployment
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

## OpenRouter (300+ Models)
# GAC_MODEL=openrouter:anthropic/claude-3.5-sonnet
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx

## Custom OpenAI-Compatible (vLLM, TGI, LocalAI, etc.)
# GAC_MODEL=custom-openai:my-model
# CUSTOM_OPENAI_API_KEY=your-proxy-key
# CUSTOM_OPENAI_BASE_URL=https://your-proxy.example.com/v1

## Custom Anthropic-Compatible (Omniroute, LiteLLM, etc.)
# GAC_MODEL=custom-anthropic:claude-3-5-sonnet-20241022
# CUSTOM_ANTHROPIC_API_KEY=your-proxy-key
# CUSTOM_ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1

# =============================================================================
# See docs/en/PROVIDERS.md for complete documentation on all 35+ providers
# =============================================================================
